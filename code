<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mehrere Bilder hochladen</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
    }
    input[type="file"] {
      margin-bottom: 20px;
    }
    .image-preview {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
    }
    .image-preview img {
      max-width: 200px;
      max-height: 200px;
      border: 1px solid #ccc;
      padding: 5px;
      border-radius: 10px;
    }
  </style>
</head>
<body>
  <h1>Mehrere Bilder hochladen</h1>
  <input type="file" accept="image/*" multiple onchange="zeigeBilder(event)" />
  <div class="image-preview" id="bildContainer"></div>

  <script>
    function zeigeBilder(event) {
      const container = document.getElementById('bildContainer');
      container.innerHTML = ""; // alte Bilder entfernen

      const files = event.target.files;

      Array.from(files).forEach(file => {
        if (file && file.type.startsWith("image/")) {
          const img = document.createElement('img');
          img.src = URL.createObjectURL(file);
          container.appendChild(img);
        }
      });
    }
  </script>
</body>
</html>
